{
    "name": "invoicepress/vampire-invoicesuite",
    "description": "A document validator for horstoeko/invoicesuite that checks e-invoices against the official EN 16931, XRechnung, Factur-X / ZUGFeRD and Peppol rule sets in pure PHP with VAMPIRE PHP. Works like the KoSIT validator of invoicesuite, without Java.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "en16931",
        "e-invoicing",
        "xrechnung",
        "zugferd",
        "factur-x",
        "peppol",
        "validator",
        "horstoeko",
        "invoicesuite",
        "vampire"
    ],
    "homepage": "https://vampire.invoicepress.de",
    "authors": [
        {
            "name": "Ralf Fuhrmann",
            "homepage": "https://invoicepress.de"
        }
    ],
    "require": {
        "php": "^8.2",
        "invoicepress/vampire-php": "^1.2",
        "horstoeko/invoicesuite": "^0.0.37"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "InvoicePress\\VampireInvoiceSuite\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "InvoicePress\\VampireInvoiceSuite\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
